{
  "name": "shopify-cartjs",
  "description": "A Javascript library to power cart management for Shopify themes.",
  "version": "1.1.0",
  "author": "Gavin Ballard",
  "url": "https://cartjs.org",
  "main": "./dist/cart.js",
  "licenses": [
    {
      "type": "MIT",
      "url": "https://github.com/discolabs/cartjs/blob/master/LICENSE"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/discolabs/cartjs.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "engineStrict": true,
  "scripts": {
    "test": "vitest run",
    "test:grunt": "grunt test",
    "test:theme": "npm run theme:check",
    "build": "vite build",
    "build:grunt": "grunt build",
    "watch": "vite build --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "ci": "npm run lint && npm run format && npm run build && npm test",
    "docs": "grunt docs",
    "theme:init": "shopify theme init theme-test --clone-url=https://github.com/Shopify/dawn --path=theme-test || shopify theme init theme-test",
    "theme:assets": "node scripts/sync-theme-assets.js",
    "theme:check": "npm run build && npm run theme:assets && shopify theme check theme-test",
    "theme:dev": "npm run build && npm run theme:assets && shopify theme dev --path=theme-test",
    "theme:push": "npm run build && npm run theme:assets && shopify theme push --path=theme-test --unpublished --json"
  },
  "devDependencies": {
    "@shopify/cli": "^4.6.1",
    "decaffeinate": "^8.1.4",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "grunt": "^1.6.3",
    "grunt-cli": "^1.5.0",
    "grunt-contrib-clean": "^2.0.1",
    "grunt-contrib-coffee": "^2.1.0",
    "grunt-contrib-compress": "^2.0.0",
    "grunt-contrib-concat": "^2.1.0",
    "grunt-contrib-copy": "^1.0.0",
    "grunt-contrib-less": "^3.0.0",
    "grunt-contrib-uglify": "^5.2.2",
    "grunt-contrib-watch": "^1.1.0",
    "grunt-exec": "^3.0.0",
    "grunt-mocha-phantomjs": "^4.0.0",
    "grunt-terraform": "~0.3.1",
    "happy-dom": "^20.11.2",
    "jquery": "^4.0.0",
    "jsdom": "^27.0.1",
    "mocha": "^11.8.0",
    "prettier": "^3.9.6",
    "rivets": "^0.9.6",
    "shopify.i18n.js": "~0.2.1",
    "should": "^13.2.3",
    "sightglass": "^0.2.6",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "terraform": "^1.27.0",
    "marked": "^4.3.0",
    "adm-zip": "^0.6.0",
    "glob": "^13.0.6",
    "minimatch": "^10.2.6",
    "inflight": "npm:lru-cache@^11.0.0",
    "diff": "^9.0.0",
    "serialize-javascript": "^7.0.3"
  },
  "dependencies": {
    "meptos": "^2.0.0",
    "tinybind": "1.0.0"
  }
}
